[user]
    name = Łukasz Gruner
    email = lukasz@gruner.lu
    signingkey = 865929DCF81AAE45
[commit]
    gpgSign = false
[push]
    default = current
    followTags = true
    recurseSubmodules = check
[pull]
    autoStash = true
	rebase = false
[rebase]
    autoStash = true
[merge]
    conflictstyle = merge
[color]
    diff = true
    grep = true
    branch = true
    decorate = true
    interactive = true
    pager = true
    showbranch = true
    status = true
    ui = true
[core]
    eol = lf
[rerere]
    enabled = true
[transfer]
    fsckobjects = true
[alias]
    serve = daemon --verbose --export-all --base-path=.git --reuseaddr --strict-paths .git/
    st = status
    ci = commit
    co = checkout
    up = pull --autoStash
    glog = log --pretty=format:\"%C(yellow)%h%C(reset) %C(green)%ad%C(reset) %C(red)|%C(reset) %s %C(bold blue)[%an]%C(reset)%C(yellow)%d%C(reset)\" --graph --date=short
    conflicts = !git diff --name-only --diff-filter=U | sort -u | xargs $EDITOR
    optimize = !git reflog expire --all --expire=now && git gc --prune=now --aggressive
[include]
    path = ~/.gitconfig.local
[safe]
	directory = *
